# ==========================================
# Google Sheets Backend Integration
# ==========================================
# The ID of your Google Sheet for Assets Management (from browser URL: /d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Google Cloud Service Account Email (Editor on your Google Sheet)
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=assets-management@your-project.iam.gserviceaccount.com

# Service Account Private Key (multiline RSA private key from the downloaded JSON)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==========================================
# Authentication
# ==========================================
# Web application OAuth client (Google Auth Platform > Clients).
# Redirect URI to register: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret

# Signs login sessions. Generate with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
AUTH_SECRET=

# Always Owner, and cannot be changed in the app. Everyone else is added on the Team page.
ADMIN_EMAILS=admin@company.com

# Production only: the public URL of the app, e.g. https://assets.example.com
# APP_URL=

